# ── Stellar Network ────────────────────────────────────────────────────────
# Options: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Admin Keypair ──────────────────────────────────────────────────────────
# Generate with: stellar keys generate --global admin
ADMIN_SECRET_KEY=your_secret_key_here
ADMIN_PUBLIC_KEY=your_public_key_here

# ── Deployed Contract IDs ──────────────────────────────────────────────────
# Populated after running: make deploy-testnet
TOKEN_CONTRACT_ID=
VESTING_CONTRACT_ID=
MULTISIG_CONTRACT_ID=

# ── Backend API ────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
